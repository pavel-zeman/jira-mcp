{
  "name": "mcp-jira-server",
  "version": "1.0.3",
  "description": "MCP server for self-hosted Jira instance with Personal Access Token authentication",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-jira-server": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts"
  },
  "keywords": [
    "mcp",
    "jira",
    "self-hosted",
    "model-context-protocol",
    "claude",
    "ai-assistant"
  ],
  "author": "edrich13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edrich13/mcp-jira-server.git"
  },
  "homepage": "https://github.com/edrich13/mcp-jira-server#readme",
  "bugs": {
    "url": "https://github.com/edrich13/mcp-jira-server/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ]
}
